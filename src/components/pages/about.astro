---
import { Image } from "astro:assets";
import { getCollection } from "astro:content";
import type { Locale } from "~/i18n";
import { useTranslations, getLocalizedPath } from "~/i18n";
import BaseLayout from "~/layouts/BaseLayout.astro";
import Button from "~/components/Button.astro";
import {
  ArrowRight,
  Shield,
  Eye,
  Zap,
  Heart,
  Wrench,
  HardHat,
  FlaskConical,
  Factory,
  Quote,
} from "@lucide/astro";

interface Props {
  lang: Locale;
  currentSlug: string;
}

const { lang, currentSlug } = Astro.props;
const { t } = useTranslations(lang);

const pagesEntries = await getCollection("pages");
const heroImage = pagesEntries.find(
  (p) => p.id.startsWith(`${lang}/`) && p.data.translationKey === "about",
)?.data.heroImage;

// Career staircase — roles first, companies as secondary context.
const career = [
  {
    icon: Wrench,
    role: "Operator",
    company: "LyondellBasell",
    detail: "Chemie- und Prozessindustrie, Arbeit direkt an der Anlage.",
  },
  {
    icon: HardHat,
    role: "Vorarbeiter & Schichtleiter",
    company: "LyondellBasell",
    detail:
      "Schichtbetrieb, Anlagen- und Instandhaltungspraxis, erste Führungsverantwortung.",
  },
  {
    icon: FlaskConical,
    role: "Teamleiter",
    company: "Scheugenpflug",
    detail:
      "Technologie- und Anwendungszentrum: Verfahrenstechnik und Teamführung.",
  },
  {
    icon: Factory,
    role: "Head of Operations & Technical Department",
    company: "NATECO2",
    detail:
      "Vom Betriebsingenieur über die technische Betriebsleitung bis heute: zwei Standorte, rund 140 Mitarbeitende, operative Strategie und die Bewertung neuer Technologien.",
  },
];

const values = [
  {
    icon: Shield,
    titleKey: "about.values.quality.title",
    descKey: "about.values.quality.description",
  },
  {
    icon: Eye,
    titleKey: "about.values.transparency.title",
    descKey: "about.values.transparency.description",
  },
  {
    icon: Zap,
    titleKey: "about.values.innovation.title",
    descKey: "about.values.innovation.description",
  },
  {
    icon: Heart,
    titleKey: "about.values.accessibility.title",
    descKey: "about.values.accessibility.description",
  },
];
---

<BaseLayout
  title={t("about.title")}
  description={t("about.description")}
  lang={lang}
  currentSlug={currentSlug}
  headerVariant="on-dark"
>
  <!-- Hero -->
  <section class="bg-surface-dark noise relative overflow-hidden">
    <div class="absolute inset-0 bg-grid opacity-20"></div>
    <div
      class="glow-orb absolute bottom-0 right-1/4 w-[500px] h-[500px] rounded-full bg-warm/10 blur-[120px] translate-y-1/3"
    >
    </div>
    <div
      class="glow-orb absolute top-1/3 -left-20 w-[400px] h-[400px] rounded-full bg-accent/15 blur-[100px]"
    >
    </div>
    <div class="container relative z-10 pt-40 pb-20 md:pt-48 md:pb-24">
      <div
        class:list={[
          "grid items-center gap-12 lg:gap-16",
          heroImage && "lg:grid-cols-2",
        ]}
      >
        <div>
          <p class="eyebrow hero-stagger" style="--delay: 100ms">
            {t("about.story.eyebrow")}
          </p>
          <h1
            class="text-display text-text-on-dark mt-6 max-w-3xl hero-stagger"
            style="--delay: 200ms"
          >
            {t("about.story.title")}
          </h1>
          <p
            class="text-body-lg text-text-on-dark/60 mt-6 max-w-2xl hero-stagger"
            style="--delay: 400ms"
          >
            {t("about.story.text")}
          </p>
        </div>
        {
          heroImage && (
            <div class="relative hero-stagger" style="--delay: 500ms">
              <div class="absolute -inset-8 rounded-[2rem] bg-gradient-to-br from-accent/20 via-transparent to-warm/20 blur-2xl" />
              <Image
                src={heroImage}
                alt="Robin Englmann spricht auf der Bühne"
                class="relative rounded-2xl shadow-2xl shadow-accent/10 ring-1 ring-white/10"
                widths={[400, 600, 800, 1200]}
                sizes="(min-width: 1024px) 50vw, 100vw"
                loading="eager"
              />
            </div>
          )
        }
      </div>
    </div>
  </section>

  <!-- Career staircase -->
  <section class="py-28 md:py-36">
    <div class="container">
      <div class="max-w-2xl anim-slide-up">
        <p class="eyebrow">{t("about.career.eyebrow")}</p>
        <h2 class="text-h2 text-text-heading mt-4">
          {t("about.career.title")}
        </h2>
        <p class="text-body-lg text-muted mt-4">
          {t("about.career.subtitle")}
        </p>
      </div>

      <ol
        class="mt-16 grid gap-6 sm:grid-cols-2 lg:grid-cols-[repeat(4,minmax(0,1fr))] lg:items-end lg:[--step-rise:2rem]"
      >
        {
          career.map((step, i) => (
            <li
              class="card anim-card-enter flex flex-col"
              style={`--delay: ${i * 120}ms; margin-bottom: calc(var(--step-rise, 0px) * ${i})`}
            >
              <div class="flex items-center justify-between">
                <div class="w-12 h-12 rounded-xl bg-accent/10 flex items-center justify-center">
                  <step.icon class="w-6 h-6 text-accent" aria-hidden="true" />
                </div>
                <span class="text-sm font-semibold text-muted">
                  {t("about.career.step", { n: i + 1 })}
                </span>
              </div>
              <h3 class="text-h3 text-text-heading mt-6 hyphens-auto break-words">
                {step.role}
              </h3>
              <p class="text-sm font-medium text-accent-hover mt-1">
                {step.company}
              </p>
              <p class="text-muted mt-3 leading-relaxed text-sm">
                {step.detail}
              </p>
            </li>
          ))
        }
      </ol>

      <p class="text-muted mt-10 max-w-3xl anim-fade">
        {t("about.career.aside")}
      </p>
    </div>
  </section>

  <!-- Signature quote -->
  <section
    class="py-28 md:py-36 bg-surface-dark noise relative overflow-hidden"
  >
    <div
      class="absolute top-0 left-1/3 w-[500px] h-[500px] rounded-full bg-accent/10 blur-[140px] -translate-y-1/2"
    >
    </div>
    <figure
      class="container relative z-10 max-w-3xl text-center anim-scale-blur"
    >
      <Quote class="w-10 h-10 text-accent-glow/50 mx-auto" aria-hidden="true" />
      <blockquote class="text-h1 text-text-on-dark mt-6">
        {
          `${t("caseStudies.quoteOpen")}${t("about.quote.text")}${t("caseStudies.quoteClose")}`
        }
      </blockquote>
      <figcaption class="text-body-lg text-text-on-dark/60 mt-6">
        {t("about.quote.caption")}
      </figcaption>
    </figure>
  </section>

  <!-- Values -->
  <section class="py-28 md:py-36">
    <div class="container">
      <div class="max-w-2xl anim-slide-up">
        <p class="eyebrow">{t("about.values.eyebrow")}</p>
        <h2 class="text-h2 text-text-heading mt-4">
          {t("about.values.title")}
        </h2>
      </div>

      <div class="grid gap-6 sm:grid-cols-2 mt-16">
        {
          values.map((val, i) => (
            <div
              class="card group anim-card-enter"
              style={`--delay: ${i * 100}ms`}
            >
              <div class="flex gap-5">
                <div class="w-12 h-12 rounded-xl bg-accent/10 flex items-center justify-center flex-shrink-0 transition-colors group-hover:bg-accent/20">
                  <val.icon class="w-6 h-6 text-accent" />
                </div>
                <div>
                  <h3 class="text-h3 text-text-heading">{t(val.titleKey)}</h3>
                  <p class="text-muted mt-2 leading-relaxed">
                    {t(val.descKey)}
                  </p>
                </div>
              </div>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <!-- CTA -->
  <section class="relative py-28 md:py-36 overflow-hidden">
    <div class="container text-center anim-scale-blur">
      <h2 class="text-h1 text-text-heading max-w-2xl mx-auto">
        {t("home.ctaSection.title")}
      </h2>
      <p class="text-body-lg text-muted mt-4 max-w-lg mx-auto">
        {t("home.ctaSection.subtitle")}
      </p>
      <div class="mt-10">
        <Button
          href={getLocalizedPath("kontakt", lang)}
          variant="primary"
          class="btn-glow group"
        >
          {t("cta.contact")}
          <ArrowRight
            class="w-4 h-4 ml-2 transition-transform group-hover:translate-x-1"
          />
        </Button>
      </div>
    </div>
  </section>
</BaseLayout>

<script>
  function initScrollAnimations() {
    if (CSS.supports("animation-timeline: scroll()")) return;
    const observer = new IntersectionObserver(
      (entries) => {
        for (const e of entries)
          if (e.isIntersecting) {
            e.target.classList.add("in-view");
            observer.unobserve(e.target);
          }
      },
      { threshold: 0.1, rootMargin: "0px 0px -50px 0px" },
    );
    document
      .querySelectorAll(
        ".anim-card-enter, .anim-slide-up, .anim-fade, .anim-scale-blur",
      )
      .forEach((el) => observer.observe(el));
  }
  initScrollAnimations();
  document.addEventListener("astro:after-swap", initScrollAnimations);
</script>
