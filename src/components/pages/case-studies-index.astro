---
import { Image } from "astro:assets";
import { getCollection } from "astro:content";
import { useTranslations, type Locale } from "~/i18n";
import BaseLayout from "~/layouts/BaseLayout.astro";
import CaseStudyCard from "~/components/CaseStudyCard.astro";
import CaseStudiesFilter from "~/components/CaseStudiesFilter.astro";
import YouTubeFacade from "~/components/YouTubeFacade.astro";
import { getAppearances, getVideos } from "~/data/appearances";
import { formatDate } from "~/lib/format-date";
import { CalendarDays, MapPin, ExternalLink } from "@lucide/astro";
import videoPoster from "~/assets/home/robin-vortrag.jpg";

interface Props {
  lang: Locale;
  currentSlug: string;
}

const { lang, currentSlug } = Astro.props;
const { t } = useTranslations(lang);

const selectedCategories = Astro.url.searchParams.getAll("category");
const selectedTags = Astro.url.searchParams.getAll("tag");
const selected: Record<string, string[]> = {
  category: selectedCategories,
  tag: selectedTags,
};

const appearances = getAppearances(lang);
const videos = getVideos(lang);

const allEntries = await getCollection("caseStudies");
const localeEntries = allEntries.filter((e) => e.id.startsWith(`${lang}/`));
let entries = localeEntries.sort((a, b) => {
  const da = a.data.publishedAt ? a.data.publishedAt.getTime() : 0;
  const db = b.data.publishedAt ? b.data.publishedAt.getTime() : 0;
  if (db !== da) return db - da;
  return a.id.localeCompare(b.id);
});

if (selectedCategories.length > 0) {
  entries = entries.filter((e) => selectedCategories.includes(e.data.category));
}
if (selectedTags.length > 0) {
  entries = entries.filter((e) =>
    e.data.tags.some((tag) => selectedTags.includes(tag)),
  );
}
---

<BaseLayout
  title={t("caseStudies.title")}
  description={t("caseStudies.description")}
  lang={lang}
  currentSlug={currentSlug}
  headerVariant="on-dark"
>
  <!-- Hero -->
  <section class="bg-surface-dark noise relative overflow-hidden">
    <div class="absolute inset-0 bg-grid opacity-20"></div>
    <div
      class="glow-orb absolute top-1/2 left-0 w-[400px] h-[400px] rounded-full bg-accent/15 blur-[120px] -translate-y-1/2 -translate-x-1/3"
    >
    </div>
    <div class="container relative z-10 pt-48 pb-20 md:pt-56 md:pb-28">
      <p class="eyebrow hero-stagger" style="--delay: 100ms">
        {t("site.name")}
      </p>
      <h1
        class="text-h1 text-text-on-dark mt-4 max-w-2xl hero-stagger"
        style="--delay: 200ms"
      >
        {t("caseStudies.title")}
      </h1>
      <p
        class="text-body-lg text-text-on-dark/60 mt-4 max-w-lg hero-stagger"
        style="--delay: 300ms"
      >
        {t("caseStudies.description")}
      </p>
    </div>
  </section>

  <!-- Appearances -->
  <section class="py-20 md:py-28">
    <div class="container max-w-4xl">
      <div class="anim-slide-up">
        <p class="eyebrow">{t("appearances.eyebrow")}</p>
        <h2 class="text-h2 text-text-heading mt-4">
          {t("appearances.title")}
        </h2>
      </div>
      <ol class="mt-12 flex flex-col gap-6">
        {
          appearances.map((item, i) => (
            <li
              class:list={[
                "card anim-card-enter",
                item.photo && "grid gap-6 md:grid-cols-[1fr_16rem] items-start",
              ]}
              style={`--delay: ${i * 100}ms`}
            >
              <div>
                <div class="flex flex-wrap items-center gap-x-5 gap-y-2 text-sm text-muted">
                  <span class="inline-flex items-center gap-1.5">
                    <CalendarDays
                      class="w-4 h-4 text-accent"
                      aria-hidden="true"
                    />
                    {formatDate(new Date(item.date), lang)}
                  </span>
                  <span class="inline-flex items-center gap-1.5">
                    <MapPin class="w-4 h-4 text-accent" aria-hidden="true" />
                    {item.city}
                  </span>
                </div>
                <h3 class="text-h3 text-text-heading mt-3">{item.event}</h3>
                <p class="text-muted mt-1">{item.host}</p>
                <p class="text-text mt-4 leading-relaxed">
                  <span class="font-semibold text-text-heading">
                    {t("appearances.talkLabel")}
                  </span>{" "}
                  {`${t("caseStudies.quoteOpen")}${item.talk}${t("caseStudies.quoteClose")}`}
                </p>
                {item.sourceUrl && (
                  <a
                    href={item.sourceUrl}
                    target="_blank"
                    rel="noopener noreferrer"
                    class="inline-flex items-center gap-1.5 mt-4 text-sm font-medium text-accent-hover hover:underline underline-offset-2"
                  >
                    {item.sourceLabel}
                    <ExternalLink class="w-3.5 h-3.5" aria-hidden="true" />
                    <span class="sr-only">({t("careers.opensInNewTab")})</span>
                  </a>
                )}
              </div>
              {item.photo && (
                <Image
                  src={item.photo}
                  alt={item.photoAlt ?? ""}
                  class="w-full aspect-[4/3] object-cover rounded-[var(--radius-md)] md:order-last order-first"
                  widths={[320, 520]}
                  sizes="(min-width: 768px) 16rem, 100vw"
                  loading="lazy"
                />
              )}
            </li>
          ))
        }
      </ol>
    </div>
  </section>

  {
    videos.length > 0 && (
      <section class="py-20 md:py-28 bg-surface-dark noise relative overflow-hidden">
        <div class="container max-w-4xl relative z-10">
          <div class="anim-slide-up">
            <p class="eyebrow text-accent-glow">
              {t("appearances.videoEyebrow")}
            </p>
            <h2 class="text-h2 text-text-on-dark mt-4">
              {t("appearances.videoTitle")}
            </h2>
          </div>
          <div class="mt-12 flex flex-col gap-10">
            {videos.map((video) => (
              <div>
                <YouTubeFacade
                  videoId={video.videoId}
                  poster={videoPoster}
                  posterAlt=""
                  title={video.title}
                  lang={lang}
                />
                <p class="text-text-on-dark font-semibold mt-4">
                  {video.title}
                </p>
                <p class="text-text-on-dark/60 text-sm">{video.channel}</p>
              </div>
            ))}
          </div>
        </div>
      </section>
    )
  }

  <!-- Filter + Grid (testimonials) — hidden until entries exist -->
  <section
    class:list={["py-20 md:py-28", localeEntries.length === 0 && "hidden"]}
  >
    <div class="container">
      <CaseStudiesFilter
        {lang}
        baseUrl={Astro.url.pathname}
        {selected}
        class="mb-12"
      />

      {
        entries.length === 0 ? (
          <p class="text-muted text-center py-16">
            {t("caseStudies.noResults")}
          </p>
        ) : (
          <div class="grid gap-8 sm:grid-cols-2 lg:grid-cols-3">
            {entries.map((entry, i) => (
              <div class="anim-card-enter" style={`--delay: ${i * 100}ms`}>
                <CaseStudyCard {entry} {lang} />
              </div>
            ))}
          </div>
        )
      }
    </div>
  </section>
</BaseLayout>

<script>
  function initScrollAnimations() {
    if (CSS.supports("animation-timeline: scroll()")) return;
    const observer = new IntersectionObserver(
      (entries) => {
        for (const e of entries)
          if (e.isIntersecting) {
            e.target.classList.add("in-view");
            observer.unobserve(e.target);
          }
      },
      { threshold: 0.1, rootMargin: "0px 0px -50px 0px" },
    );
    document
      .querySelectorAll(".anim-card-enter, .anim-slide-up, .anim-fade")
      .forEach((el) => observer.observe(el));
  }
  initScrollAnimations();
  document.addEventListener("astro:after-swap", initScrollAnimations);
</script>
